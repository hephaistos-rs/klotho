  "query": "SELECT r.id AS \"id!\", r.name, r.created_at, r.private AS \"private: bool\", o.id AS \"owner_id!\", o.name AS owner_name, o.kind AS owner_kind\n               FROM repositories r JOIN owners o ON o.id = r.owner_id\n               WHERE r.owner_id = ? AND r.name_key > ? AND (r.private = 0 OR ?)\n               ORDER BY r.name_key LIMIT ?",
