{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo xtask:*)",
      "Bash(cargo doc:*)",
      "Bash(rustfmt:*)",
      "Bash(topcoat fmt:*)",
      "Bash(bash .claude/skills/gate/gate.sh:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git --version)",
      "PowerShell(cargo fmt:*)",
      "PowerShell(cargo clippy:*)",
      "PowerShell(cargo test:*)",
      "PowerShell(cargo check:*)",
      "PowerShell(cargo build:*)",
      "PowerShell(cargo deny:*)",
      "PowerShell(cargo xtask:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-migrations.sh\"", "timeout": 10 },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-markdown.sh\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rustfmt.sh\"", "timeout": 30 }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
