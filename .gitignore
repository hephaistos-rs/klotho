# Allowlist: ignore every file, then allow the file types we track.
# `!dir/` only re-includes a directory, not the files in it, so files are
# allowed by type. A new kind of file needs a line here (or `git add -f`).
*

# Descend into directories (the ignores at the bottom carve some back out)
!*/

# Repository metadata
!.gitignore
!.gitattributes
!.editorconfig
!LICENSE*
!README*
!CHANGELOG*
!CONTRIBUTING*

# Rust and Cargo (Cargo.toml, Cargo.lock, rustfmt.toml, deny.toml, .cargo/config.toml, ...)
!*.rs
!*.toml
!Cargo.lock

# Docs
!*.md

# Database migrations
!*.sql

# Web assets (crates/web): styles, vendored scripts, fonts, images
!*.css
!*.js
!*.mjs
!*.svg
!*.png
!*.ico
!*.woff2

# CI and other config
!*.yml
!*.yaml
!*.json

# Never track these, even if a pattern above matches.
# They come last so they win over the `!` lines.

# Generated by Cargo (also holds the Topcoat asset bundle)
/target/

# Repositories created by a local `klotho serve` (default KLOTHO_REPOS)
/testRepos/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc dumps stack traces here when it hits an internal compiler error
rustc-ice-*.txt
