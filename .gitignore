# Allowlist: ignore every file, then allow what we track.
# `!dir/` only re-includes a directory, not the files in it, so files are
# allowed by type or by path. A new kind of file needs a line here
# (or a one-off `git add -f`).
# Order matters: the last matching line wins.
*

# Descend into directories (the ignores at the bottom carve some back out)
!*/

# Repository metadata
!.gitignore
!.gitattributes
!.editorconfig
!LICENSE*
!README*
!CHANGELOG*
!CONTRIBUTING*
!SECURITY*

# Rust and Cargo (Cargo.toml, Cargo.lock, rustfmt.toml, deny.toml,
# components.toml, .cargo/config.toml, ...)
!*.rs
!*.toml
!Cargo.lock

# Database migrations
!*.sql

# sqlx offline query data: required for SQLX_OFFLINE builds
!.sqlx/*.json

# Web assets (crates/web): styles, vendored scripts, fonts, images
!*.css
!*.js
!*.mjs
!*.svg
!*.png
!*.ico
!*.woff2

# Vendored assets: the Iconify set, pinned versions, and licences
# (crates/web/build.rs)
!crates/web/icons/*.json
!crates/web/icons/*.version
!crates/web/icons/*.txt
!crates/web/assets/fonts/*.txt

# CI and other config
!*.yml
!*.yaml

# Markdown: only these, not every note an agent writes
!AGENTS.md
!CLAUDE.md
!ROADMAP.md
!/DESIGN.md
!/PRODUCT.md
!docs/**/*.md

# Impeccable: keep only the rubric the Klotho gate grades against;
# the rest of .impeccable/ is per-run scratch
!/.impeccable/klotho-rubric.md

# Claude Code project config: skills (and their scripts), review agents,
# hooks, the settings that wire them up, and the MCP servers. Personal
# settings (.claude/settings.local.json, *.local.md) stay ignored.
!/.claude/skills/*/SKILL.md
!/.claude/skills/*/*.sh
!/.claude/agents/*.md
!/.claude/hooks/*.sh
!/.claude/settings.json
!/.mcp.json

# Never track these, even if a pattern above matches.
# They come last so they win over the `!` lines.

# Generated by Cargo (also holds the Topcoat asset bundle)
/target/

# Release output of `cargo xtask dist`
/dist/

# Data directories: the default (data_dir = "data") and the development one
# (klotho.dev.toml). Their files/ folder can hold images that the allowlist
# above would otherwise pick up.
/data/
/testRepos/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc dumps stack traces here when it hits an internal compiler error
rustc-ice-*.txt